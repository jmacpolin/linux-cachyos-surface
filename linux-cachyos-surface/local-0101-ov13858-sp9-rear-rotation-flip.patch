From 82601b2dfc68e6485a31d3eeef4fc0e7f33f296f Mon Sep 17 00:00:00 2001
From: Eva Dixon <eva@dixon.solutions>
Date: Wed, 12 Aug 2026 08:20:00 +1000
Subject: [PATCH] media: ipu-bridge/ov13858: fix Surface Pro 8 and 9 rear
 camera rotation

The rear OV13858 (ACPI HID OVTID858) on the Surface Pro 8 and 9 is mounted
upside down, but the SSDB in ACPI reports degree=0.

1. ipu-bridge: add OVTID858 quirk entries for both machines. The front
   sensor of each already has an entry, and dmi_first_match() stops at
   it, so keep walking the table past the first DMI match until the HID
   matches as well.
2. ov13858: force rotation=180 (orientation=Back if unknown) on these
   machines when the fwnode properties do not already say so.
3. ov13858: add HFLIP/VFLIP controls. rotation=180 on its own only
   describes the mounting; libcamera turns the frame around with the
   sensor flips, and without them the pixels stay upside down. Each flip
   moves the crop window by one pixel so the Bayer order stays GRBG. The
   flips are grabbed while streaming.

Flip registers follow the out-of-tree ov13858 that fixes the Pro 8 rear
camera.

Link: https://github.com/linux-surface/linux-surface/issues/1865
Link: https://github.com/linux-surface/linux-surface/issues/1892
Link: https://github.com/linux-surface/linux-surface/pull/2227#issuecomment-5481167166
Link: https://github.com/fildunsky/linux-surface-pro8-cameras
[linux-cachyos-surface: ported from upstream PR #2227 (6.19) to 7.2.9;
 dropped the ipu_bridge_parse_rotation() change, since 7.2.9 already
 walks every DMI match upstream]
Patchset: cameras
Signed-off-by: Eva Dixon <eva@dixon.solutions>
---
 drivers/media/i2c/ov13858.c          | 119 ++++++++++++++++++++++++++-
 drivers/media/pci/intel/ipu-bridge.c |  14 ++++
 2 files changed, 132 insertions(+), 1 deletion(-)

diff --git a/drivers/media/i2c/ov13858.c b/drivers/media/i2c/ov13858.c
index 015493a16..879227013 100644
--- a/drivers/media/i2c/ov13858.c
+++ b/drivers/media/i2c/ov13858.c
@@ -3,6 +3,7 @@
 
 #include <linux/acpi.h>
 #include <linux/delay.h>
+#include <linux/dmi.h>
 #include <linux/clk.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
@@ -82,6 +83,13 @@
 #define OV13858_TEST_PATTERN_ENABLE	BIT(7)
 #define OV13858_TEST_PATTERN_MASK	0xfc
 
+/* Flip control, and the crop window offsets that keep the Bayer order */
+#define OV13858_REG_FORMAT1		0x3820
+#define OV13858_FORMAT1_HFLIP_OFF	BIT(3)
+#define OV13858_FORMAT1_VFLIP		(BIT(4) | BIT(5))
+#define OV13858_REG_H_WIN_OFFSET	0x3811
+#define OV13858_REG_V_WIN_OFFSET	0x3813
+
 /* Number of frames to skip */
 #define OV13858_NUM_OF_SKIP_FRAMES	2
 
@@ -1051,6 +1059,8 @@ struct ov13858 {
 	struct v4l2_ctrl *vblank;
 	struct v4l2_ctrl *hblank;
 	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
 
 	/* Current mode */
 	const struct ov13858_mode *cur_mode;
@@ -1331,6 +1341,63 @@ static int ov13858_enable_test_pattern(struct ov13858 *ov13858, u32 pattern)
 				 OV13858_REG_VALUE_08BIT, val);
 }
 
+/*
+ * Set, clear or offset a register the mode table has just written. The flips
+ * are grabbed while streaming and the sensor is only powered while streaming,
+ * so this runs once per stream start, from __v4l2_ctrl_handler_setup(), right
+ * after the mode table. That is also why turning a flip off writes nothing:
+ * the mode table has already put the unflipped values back.
+ */
+static int ov13858_update_reg(struct ov13858 *ov13858, u16 reg,
+			      u32 set, u32 clear, int offset)
+{
+	int ret;
+	u32 val;
+
+	ret = ov13858_read_reg(ov13858, reg, OV13858_REG_VALUE_08BIT, &val);
+	if (ret)
+		return ret;
+
+	val = ((val | set) & ~clear) + offset;
+
+	return ov13858_write_reg(ov13858, reg, OV13858_REG_VALUE_08BIT, val);
+}
+
+/*
+ * Mirroring and flipping each shift the Bayer order by one pixel. Moving the
+ * crop window by one pixel shifts it back, so the format stays GRBG and the
+ * flips can be left without V4L2_CTRL_FLAG_MODIFY_LAYOUT.
+ */
+static int ov13858_set_hflip(struct ov13858 *ov13858, u32 enable)
+{
+	int ret;
+
+	if (!enable)
+		return 0;
+
+	ret = ov13858_update_reg(ov13858, OV13858_REG_FORMAT1,
+				 0, OV13858_FORMAT1_HFLIP_OFF, 0);
+	if (ret)
+		return ret;
+
+	return ov13858_update_reg(ov13858, OV13858_REG_H_WIN_OFFSET, 0, 0, 1);
+}
+
+static int ov13858_set_vflip(struct ov13858 *ov13858, u32 enable)
+{
+	int ret;
+
+	if (!enable)
+		return 0;
+
+	ret = ov13858_update_reg(ov13858, OV13858_REG_FORMAT1,
+				 OV13858_FORMAT1_VFLIP, 0, 0);
+	if (ret)
+		return ret;
+
+	return ov13858_update_reg(ov13858, OV13858_REG_V_WIN_OFFSET, 0, 0, -1);
+}
+
 static int ov13858_set_ctrl(struct v4l2_ctrl *ctrl)
 {
 	struct ov13858 *ov13858 = container_of(ctrl->handler,
@@ -1380,6 +1447,12 @@ static int ov13858_set_ctrl(struct v4l2_ctrl *ctrl)
 	case V4L2_CID_TEST_PATTERN:
 		ret = ov13858_enable_test_pattern(ov13858, ctrl->val);
 		break;
+	case V4L2_CID_HFLIP:
+		ret = ov13858_set_hflip(ov13858, ctrl->val);
+		break;
+	case V4L2_CID_VFLIP:
+		ret = ov13858_set_vflip(ov13858, ctrl->val);
+		break;
 	default:
 		dev_info(ov13858->dev,
 			 "ctrl(id:0x%x,val:0x%x) is not handled\n",
@@ -1603,6 +1676,10 @@ static int ov13858_set_stream(struct v4l2_subdev *sd, int enable)
 		pm_runtime_put(ov13858->dev);
 	}
 
+	/* The flips move the crop window, so they cannot change mid-stream */
+	__v4l2_ctrl_grab(ov13858->hflip, enable);
+	__v4l2_ctrl_grab(ov13858->vflip, enable);
+
 	mutex_unlock(&ov13858->mutex);
 
 	return ret;
@@ -1675,6 +1752,26 @@ static const struct v4l2_subdev_internal_ops ov13858_internal_ops = {
 	.open = ov13858_open,
 };
 
+/*
+ * The rear OV13858 on these is mounted upside down, but the SSDB in ACPI
+ * reports 0 degrees.
+ */
+static const struct dmi_system_id ov13858_upside_down_dmi_ids[] = {
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Microsoft Corporation"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "Surface Pro 8"),
+		},
+	},
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Microsoft Corporation"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "Surface Pro 9"),
+		},
+	},
+	{ }
+};
+
 /* Initialize control handlers */
 static int ov13858_init_controls(struct ov13858 *ov13858)
 {
@@ -1690,7 +1787,7 @@ static int ov13858_init_controls(struct ov13858 *ov13858)
 	int ret;
 
 	ctrl_hdlr = &ov13858->ctrl_handler;
-	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 10);
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 12);
 	if (ret)
 		return ret;
 
@@ -1749,6 +1846,15 @@ static int ov13858_init_controls(struct ov13858 *ov13858)
 				     V4L2_CID_TEST_PATTERN,
 				     ARRAY_SIZE(ov13858_test_pattern_menu) - 1,
 				     0, 0, ov13858_test_pattern_menu);
+
+	/*
+	 * libcamera undoes the mounting rotation with these. Without them it
+	 * reports rotation=180 but the frames still come out upside down.
+	 */
+	ov13858->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &ov13858_ctrl_ops,
+					   V4L2_CID_HFLIP, 0, 1, 1, 0);
+	ov13858->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &ov13858_ctrl_ops,
+					   V4L2_CID_VFLIP, 0, 1, 1, 0);
 	if (ctrl_hdlr->error) {
 		ret = ctrl_hdlr->error;
 		dev_err(ov13858->dev, "%s control init failed (%d)\n",
@@ -1760,6 +1866,17 @@ static int ov13858_init_controls(struct ov13858 *ov13858)
 	if (ret)
 		goto error;
 
+	/*
+	 * ipu-bridge applies the same quirk, but the sensor can probe before
+	 * ipu-bridge has attached its software node properties.
+	 */
+	if (dmi_check_system(ov13858_upside_down_dmi_ids)) {
+		props.rotation = 180;
+		if (props.orientation == V4L2_FWNODE_ORIENTATION_EXTERNAL)
+			props.orientation = V4L2_FWNODE_ORIENTATION_BACK;
+		dev_info(ov13858->dev, "upside-down module, rotation=180\n");
+	}
+
 	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &ov13858_ctrl_ops,
 					      &props);
 	if (ret)
diff --git a/drivers/media/pci/intel/ipu-bridge.c b/drivers/media/pci/intel/ipu-bridge.c
index 8a82fd99e..38ec6590a 100644
--- a/drivers/media/pci/intel/ipu-bridge.c
+++ b/drivers/media/pci/intel/ipu-bridge.c
@@ -145,6 +145,13 @@ static const struct dmi_system_id upside_down_sensor_dmi_ids[] = {
 		},
 		.driver_data = "INT33BE",
 	},
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Microsoft Corporation"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "Surface Pro 8"),
+		},
+		.driver_data = "OVTID858",
+	},
 	{
 		.matches = {
 			DMI_MATCH(DMI_SYS_VENDOR, "Microsoft Corporation"),
@@ -152,6 +159,13 @@ static const struct dmi_system_id upside_down_sensor_dmi_ids[] = {
 		},
 		.driver_data = "OVTI5693",
 	},
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Microsoft Corporation"),
+			DMI_MATCH(DMI_PRODUCT_NAME, "Surface Pro 9"),
+		},
+		.driver_data = "OVTID858",
+	},
 	{} /* Terminating entry */
 };
 
